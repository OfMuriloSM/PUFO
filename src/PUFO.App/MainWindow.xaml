<Window x:Class="PUFO.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PUFO.App.Controls"
        Title="PUFO" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Top="0" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" UseLayoutRounding="True" FontFamily="Segoe UI"
        Foreground="{DynamicResource PufoText}" PreviewKeyDown="AoPressionarTecla">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Preto.xaml"/></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="Secondary" Color="#93939D"/>
        <SolidColorBrush x:Key="Accent" Color="#F5F5F7"/>
        <Geometry x:Key="Speaker">M 3,9 L 7,9 12,5 12,19 7,15 3,15 Z M 16,8 C 19,10 19,14 16,16 M 19,5 C 24,9 24,15 19,19</Geometry>
        <Geometry x:Key="Muted">M 3,9 L 7,9 12,5 12,19 7,15 3,15 Z M 17,9 L 23,15 M 23,9 L 17,15</Geometry>
        <Geometry x:Key="ChevronDown">M 3,5 L 8,10 13,5</Geometry>
        <Geometry x:Key="ChevronUp">M 3,10 L 8,5 13,10</Geometry>
        <Geometry x:Key="Close">M 6,6 L 18,18 M 18,6 L 6,18</Geometry>
        <Style x:Key="Vector" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#1C1C20"/>
            <Setter Property="Foreground" Value="#E7E7EC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="20" BorderThickness="0" BorderBrush="#12FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#34343B"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#484850"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{StaticResource Accent}"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="24">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="16" Height="16" CornerRadius="8" Background="#FFFFFF"><Border.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25"/></Border.Effect></Border></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="#303037"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#202A26"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SaidaButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DBDBE1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#202024"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#303036"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fundo" Property="BorderBrush" Value="#BDBDC9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Indicador" Background="#46464F" CornerRadius="3" Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Indicador" Property="Background" Value="#777781"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid x:Name="Raiz" Margin="16,0,16,20"
          MouseEnter="AoEntrarNaArea" MouseLeave="AoSairDaArea"
          MouseLeftButtonDown="AoClicarEsquerdoNaArea" MouseRightButtonDown="AoClicarDireitoNaArea">
        <Border x:Name="AreaAtivacao" Width="126" Height="12" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#01000000"/>
        <!-- A single hit target survives every morph; transparent outer margins stay click-through. -->
        <Border x:Name="Capsula" SizeChanged="AoRedimensionarCapsula" Width="126" Height="24" Background="{DynamicResource PufoSurface}"
                BorderBrush="#171719" BorderThickness="1" CornerRadius="15"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                >
            <Border.RenderTransform><TranslateTransform x:Name="CapsulaTranslate" Y="-12"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.38"/></Border.Effect>
            <Grid x:Name="Recorte">
                <controls:MedidorConteudo>
                <Grid x:Name="ConteudoIlha" SizeChanged="AoMudarTamanhoConteudo" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid x:Name="ViewRepouso" Width="124" Height="22"/>
                    <ContentControl x:Name="HostPrevia" Visibility="Collapsed" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="ViewPrevia" Margin="7,4" KeyboardNavigation.TabNavigation="Cycle">
                            <ItemsControl x:Name="Atalhos" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Width="31" Height="28" Background="Transparent"
                                            IsEnabled="{Binding Disponivel}" AutomationProperties.Name="{Binding Nome}" ToolTip="{Binding Nome}"
                                            MouseEnter="AoApontarModulo" MouseLeave="AoDeixarIcone" GotKeyboardFocus="AoFocarModulo" Click="AoAcionarModulo">
                                        <Path Data="{Binding Icone}" Width="15" Height="15">
                                            <Path.Style><Style TargetType="Path" BasedOn="{StaticResource Vector}">
                                                <Style.Triggers><DataTrigger Binding="{Binding Preenchido}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Accent}"/><Setter Property="StrokeThickness" Value="0"/>
                                                </DataTrigger></Style.Triggers>
                                            </Style></Path.Style>
                                        </Path>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl x:Name="HostModulo" HorizontalContentAlignment="Stretch">
                                <StackPanel x:Name="PainelAudioPrevia" Margin="8,3,8,6" MaxWidth="265">
                                    <Border Height="1" Background="#262629" Margin="0,0,0,7"/>
                                    <TextBlock x:Name="DispositivoPrevia" FontSize="11" Foreground="#B5B5BE" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Button x:Name="BtnMutePreview" Width="26" Height="26" Background="Transparent" Style="{StaticResource IconButton}" Click="BtnMutePreview_Click" AutomationProperties.Name="Silenciar áudio">
                                            <Path x:Name="IconeMutePreview" Style="{StaticResource Vector}" Data="{StaticResource Speaker}" Width="16" Height="16"/>
                                        </Button>
                                        <controls:SliderSincronizado x:Name="SliderPrevia" Grid.Column="1" MinWidth="102" Height="26" Margin="8,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource VolumeSlider}" ValueChanged="SliderVolume_ValueChanged" AutomationProperties.Name="Volume na prévia"/>
                                        <TextBlock x:Name="TxtVolumePreview" Grid.Column="2" FontSize="11" VerticalAlignment="Center" MinWidth="31" TextAlignment="Right"/>
                                    </Grid>
                                    <StackPanel x:Name="DetalhesAudioPrevia">
                                        <TextBlock x:Name="EstadoSom" Text="Aguardando medição" FontSize="11" Foreground="#A8A8B1"/>
                                        <ScrollViewer MaxHeight="78" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="FontesAtivas"><ItemsControl.ItemTemplate><DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <Image Width="15" Height="15" Source="{Binding Icone}" Margin="0,0,6,0" DockPanel.Dock="Left">
                                                        <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Icone}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style>
                                                    </Image>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12" Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10" Foreground="#AAAAAF" Text="{Binding Saida}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Saida}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button x:Name="AbrirMixerPrevia" Content="Mixer" Style="{StaticResource SaidaButton}" Click="AoAbrirMixerDaPrevia" Padding="5,3"/>
                                            <Button x:Name="AbrirSaidasPrevia" Content="Saídas" Style="{StaticResource SaidaButton}" Click="AoAbrirSaidasDaPrevia" Padding="5,3"/>
                                            <Button x:Name="Reproducoes" Visibility="Collapsed" Style="{StaticResource SaidaButton}" Click="AoAbrirReproducoes" Padding="5,3"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>
                            <controls:CartaoMidia x:Name="MidiaCompacta" Compacto="True" MaxWidth="210" Margin="4,2" Visibility="Collapsed"/>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl x:Name="HostCompleto" Visibility="Collapsed" HorizontalContentAlignment="Stretch">
                        <ScrollViewer x:Name="RolagemCompleto" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="ViewCompleto" Margin="19,12,19,14" MinWidth="270" MaxWidth="350">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="BarraVolumeGeral">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="43"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnMuteCompleto" Width="32" Height="32" Style="{StaticResource IconButton}"
                                            Click="BtnMuteCompleto_Click" AutomationProperties.Name="Silenciar áudio">
                                        <Path x:Name="IconeMuteCompleto" Style="{StaticResource Vector}" Data="{StaticResource Speaker}" Width="18" Height="18"/>
                                    </Button>
                                    <controls:SliderSincronizado x:Name="SliderVolume" Grid.Column="1" MinWidth="110" Margin="10,0,0,0"
                                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Style="{StaticResource VolumeSlider}" ValueChanged="SliderVolume_ValueChanged" AutomationProperties.Name="Volume geral"/>
                                    <TextBlock x:Name="TxtVolumeCompleto" Grid.Column="2" TextAlignment="Right" Margin="0,0,7,0"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnMixer" Grid.Column="3" Width="30" Height="30" Background="Transparent"
                                            Style="{StaticResource IconButton}" Click="AoAlternarMixer" ToolTip="Expandir mixer" AutomationProperties.Name="Expandir mixer">
                                        <Path x:Name="IconeMixer" Style="{StaticResource Vector}" Data="{StaticResource ChevronDown}" Width="13" Height="13"/>
                                    </Button>
                                </Grid>
                                <controls:PainelRevelavel x:Name="RevelaMixer" Grid.Row="1" ClipToBounds="True">
                                <StackPanel x:Name="PainelMixer" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Border Height="1" Background="#242429" Margin="0,0,0,7"/>
                                    <TextBlock Text="Aplicativos" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Secondary}" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="MixerVazio" Text="Nenhuma sessão de áudio" FontSize="12" Foreground="{StaticResource Secondary}" Margin="0,8"/>
                                    <ScrollViewer x:Name="RolagemMixer" MaxHeight="215" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel x:Name="LinhasMixer" KeyboardNavigation.TabNavigation="Continue"/>
                                    </ScrollViewer>
                                </StackPanel>
                                </controls:PainelRevelavel>
                                <controls:PainelRevelavel x:Name="RevelaMidia" Grid.Row="2" ClipToBounds="True" IsHitTestVisible="False">
                                    <controls:CartaoMidia x:Name="MidiaCompleta" Visibility="Collapsed"/>
                                </controls:PainelRevelavel>
                                <StackPanel Grid.Row="3" Margin="0,9,0,0">
                                    <Border Height="1" Background="#242429" Margin="0,0,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Button x:Name="BtnSaida" Click="AoAlternarSaidas" HorizontalAlignment="Stretch"
                                                Style="{StaticResource SaidaButton}" Foreground="{StaticResource Secondary}"
                                                Padding="3,3,8,3" ToolTip="Selecionar saída de áudio">
                                            <DockPanel>
                                                <Path DockPanel.Dock="Left" Data="M 1,2 H 11 V 8 H 1 Z M 4,11 H 8" Stroke="{StaticResource Secondary}"
                                                      StrokeThickness="1.3" StrokeLineJoin="Round" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <Path x:Name="IconeSaidas" DockPanel.Dock="Right" Data="{StaticResource ChevronDown}"
                                                      Style="{StaticResource Vector}" Width="11" Height="11" Margin="7,0,0,0"/>
                                                <TextBlock x:Name="TxtDispositivoCompleto" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                            </DockPanel>
                                        </Button>
                                        <Button x:Name="Engrenagem" Grid.Column="1" Width="26" Height="26" Background="Transparent" Style="{StaticResource IconButton}" Click="AoAbrirConfiguracoesNaIlha" ToolTip="Configurações" AutomationProperties.Name="Abrir configurações do PUFO">
                                            <Path Style="{StaticResource Vector}" Width="15" Height="15" Data="M 10,2 L 14,2 15,5 17,6 20,5 22,9 20,11 20,13 22,15 20,19 17,18 15,19 14,22 10,22 9,19 7,18 4,19 2,15 4,13 4,11 2,9 4,5 7,6 9,5 Z M 15.5,12 A 3.5,3.5 0 1 1 8.5,12 A 3.5,3.5 0 1 1 15.5,12 Z"/>
                                        </Button>
                                        <Button Grid.Column="2" Width="25" Height="25" Background="Transparent" Style="{StaticResource IconButton}"
                                                Click="BtnFecharCompleto_Click" ToolTip="Recolher (Esc)" AutomationProperties.Name="Recolher cápsula">
                                            <Path Style="{StaticResource Vector}" Data="{StaticResource Close}" Width="9" Height="9"/>
                                        </Button>
                                    </Grid>
                                    <controls:PainelRevelavel x:Name="RevelaSaidas" ClipToBounds="True">
                                        <StackPanel x:Name="PainelSaidas" Visibility="Collapsed" Margin="0,6,0,0">
                                            <Border Background="#121215" CornerRadius="12" Padding="4">
                                                <ScrollViewer MaxHeight="148" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl x:Name="ListaSaidas" AutomationProperties.Name="Saídas de áudio">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button x:Name="Opcao" Style="{StaticResource SaidaButton}" Click="AoSelecionarSaida"
                                                                        AutomationProperties.Name="{Binding NomeAcessivel}" ToolTip="{Binding Nome}">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                                                                        <Path Data="M 1,2 H 11 V 8 H 1 Z M 4,11 H 8" Stroke="#ADADB6" StrokeThickness="1.3" StrokeLineJoin="Round" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Nome}" TextWrapping="Wrap" FontSize="12"/>
                                                                        <Path x:Name="MarcaPadrao" Grid.Column="2" Data="M 2,7 L 5,10 11,3" Stroke="#F5F5F7"
                                                                              StrokeThickness="1.5" StrokeLineJoin="Round" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                    </Grid>
                                                                </Button>
                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Padrao}" Value="True">
                                                                        <Setter TargetName="MarcaPadrao" Property="Visibility" Value="Visible"/>
                                                                        <Setter TargetName="Opcao" Property="Background" Value="#242428"/>
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                            <TextBlock x:Name="MensagemSaida" Foreground="{StaticResource Secondary}" FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="Som no Windows" Click="AoAbrirSomWindows" HorizontalAlignment="Left"
                                                    Style="{StaticResource SaidaButton}" Foreground="#ABABB6" Padding="5,4"/>
                                        </StackPanel>
                                    </controls:PainelRevelavel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </ContentControl>
                </Grid>
                </controls:MedidorConteudo>
            </Grid>
        </Border>
    </Grid>
</Window>
