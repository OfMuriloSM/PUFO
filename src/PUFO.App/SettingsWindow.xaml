<Window x:Class="PUFO.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações do PUFO" Width="740" Height="470" MinWidth="560" MinHeight="350"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" UseLayoutRounding="True"
        Background="{DynamicResource PufoWindow}" Foreground="{DynamicResource PufoText}" FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/ControlesConfiguracoes.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource PufoWindow}" BorderBrush="{StaticResource PufoBorder}" BorderThickness="1" CornerRadius="10">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Path Data="M 8,3 H 18 A 5,5 0 0 1 18,13 H 8 A 5,5 0 0 1 8,3 Z" Stroke="#C5C5CE" StrokeThickness="1.5" VerticalAlignment="Center"/>
                <TextBlock Text="PUFO / Configurações" Margin="9,0,0,0" FontSize="12" Foreground="{StaticResource PufoSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,6,2" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="Minimizar" Click="AoMinimizar" Style="{StaticResource LegendaJanela}" AutomationProperties.Name="Minimizar" ToolTip="Minimizar">
                    <Path Data="M 2,8 H 13" Style="{StaticResource TracoJanela}"/>
                </Button>
                <Button x:Name="Maximizar" Click="AoMaximizar" Style="{StaticResource LegendaJanela}" AutomationProperties.Name="Maximizar" ToolTip="Maximizar">
                    <Path x:Name="SimboloMaximizar" Data="M 2,2 H 13 V 13 H 2 Z" Style="{StaticResource TracoJanela}"/>
                </Button>
                <Button x:Name="Fechar" Click="AoFechar" Style="{StaticResource LegendaJanela}" AutomationProperties.Name="Fechar" ToolTip="Fechar">
                    <Path Data="M 2,2 L 13,13 M 13,2 L 2,13" Style="{StaticResource TracoJanela}"/>
                </Button>
            </StackPanel>
        </Grid>
    <Grid Margin="14,0,14,14">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TabControl x:Name="Categorias" TabStripPlacement="Left" SelectionChanged="AoMudarCategoria" KeyboardNavigation.TabNavigation="Local">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#111113" BorderBrush="{StaticResource PufoBorder}" BorderThickness="1" CornerRadius="15" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="7,7,0,18">
                                    <Border Width="26" Height="15" CornerRadius="8" Background="Black" BorderBrush="#9999A4" BorderThickness="1" VerticalAlignment="Center"/>
                                    <TextBlock Text="PUFO" Foreground="{StaticResource PufoText}" FontWeight="SemiBold" Margin="9,0,0,0"/>
                                </StackPanel>
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Column="1" Margin="17,0,0,0" Padding="4,8,5,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="Geral" Tag="M 2,3 H 15 M 2,8 H 15 M 2,13 H 15 M 5,1 V 5 M 11,6 V 10 M 7,11 V 15">
                <StackPanel>
                    <TextBlock Text="Geral" Style="{StaticResource Titulo}"/>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <CheckBox x:Name="IniciarWindows" Content="Iniciar com o Windows" Style="{StaticResource Interruptor}" Checked="AoMudarInicializacao" Unchecked="AoMudarInicializacao"/>
                        <TextBlock x:Name="EstadoInicializacao" Style="{StaticResource Legenda}" Margin="0,4,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <TextBlock Text="Versão do PUFO" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Versao" Style="{StaticResource Legenda}" Margin="0,4,0,0"/>
                    </StackPanel></Border>
                    <Button Content="Abrir pasta de configurações" Style="{StaticResource Acao}" Click="AoAbrirPasta" Margin="0,5,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Ilha" Tag="M 5,4 H 12 C 18,4 18,12 12,12 H 5 C -1,12 -1,4 5,4 Z">
                <StackPanel>
                    <TextBlock Text="Ilha" Style="{StaticResource Titulo}"/>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=TempoHover, Path=Value, StringFormat={}{0:0} ms}" Style="{StaticResource Legenda}"/><TextBlock Text="Tempo para abrir a prévia"/></DockPanel>
                        <Slider x:Name="TempoHover" Style="{StaticResource Faixa}" TickFrequency="50" SmallChange="50" LargeChange="100"
                                ValueChanged="AoAlterarValor" AutomationProperties.Name="Tempo para abrir a prévia, em milissegundos"/>
                        <DockPanel Margin="0,9,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=TempoFechamento, Path=Value, StringFormat={}{0:0} ms}" Style="{StaticResource Legenda}"/><TextBlock Text="Tempo para recolher a prévia"/></DockPanel>
                        <Slider x:Name="TempoFechamento" Style="{StaticResource Faixa}" TickFrequency="50" SmallChange="50" LargeChange="100"
                                ValueChanged="AoAlterarValor" AutomationProperties.Name="Tempo para recolher a prévia, em milissegundos"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <CheckBox x:Name="AnimarIlha" Content="Animações" Style="{StaticResource Interruptor}" Checked="AoAlterarPreferencia" Unchecked="AoAlterarPreferencia"/>
                        <DockPanel Margin="0,8,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=Velocidade, Path=Value, StringFormat={}{0:0}%}" Style="{StaticResource Legenda}"/><TextBlock x:Name="RotuloVelocidade" Text="Velocidade das transições"/></DockPanel>
                        <Slider x:Name="Velocidade" Style="{StaticResource Faixa}" TickFrequency="10" SmallChange="10" LargeChange="20"
                                ValueChanged="AoAlterarValor" AutomationProperties.Name="Velocidade das transições, em porcentagem"/>
                        <TextBlock Text="A preferência de reduzir movimento do Windows também é respeitada." Style="{StaticResource Legenda}" Margin="0,5,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Áudio" Tag="M 2,6 H 5 L 9,2 V 14 L 5,10 H 2 Z M 12,5 Q 16,8 12,11 M 14,2 Q 20,8 14,14">
                <StackPanel>
                    <TextBlock Text="Áudio" Style="{StaticResource Titulo}"/>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <CheckBox x:Name="PreviaAudio" Content="Prévia contextual de volume" Style="{StaticResource Interruptor}" Checked="AoAlterarPreferencia" Unchecked="AoAlterarPreferencia"/>
                        <TextBlock Text="Mostra a prévia quando o volume ou mute do Windows muda." Style="{StaticResource Legenda}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <CheckBox x:Name="AbrirMixer" Content="Abrir com o mixer expandido" Style="{StaticResource Interruptor}" Checked="AoAlterarPreferencia" Unchecked="AoAlterarPreferencia"/>
                        <TextBlock Text="Define a posição inicial do mixer ao abrir o painel de áudio." Style="{StaticResource Legenda}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <TextBlock Text="Saída atual" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SaidaAtual" Style="{StaticResource Legenda}" Margin="0,4,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Mídia" Tag="M 3,2 V 14 L 14,8 Z">
                <StackPanel>
                    <TextBlock Text="Mídia" Style="{StaticResource Titulo}"/>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <CheckBox x:Name="HabilitarMidia" Content="Controles de mídia" Style="{StaticResource Interruptor}" Checked="AoAlterarPreferencia" Unchecked="AoAlterarPreferencia"/>
                        <CheckBox x:Name="PreviaMidia" Content="Mostrar mídia na prévia" Margin="0,8,0,0" Style="{StaticResource Interruptor}" Checked="AoAlterarPreferencia" Unchecked="AoAlterarPreferencia"/>
                        <CheckBox x:Name="PriorizarMidia" Content="Priorizar a faixa durante a reprodução" Margin="0,8,0,0" Style="{StaticResource Interruptor}" Checked="AoAlterarPreferencia" Unchecked="AoAlterarPreferencia"/>
                        <TextBlock Text="Com a prioridade desligada, um ajuste de volume aparece temporariamente na prévia." Style="{StaticResource Legenda}" Margin="0,6,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <TextBlock Text="Sessão selecionada" FontWeight="SemiBold"/>
                        <TextBlock x:Name="MidiaAtual" Style="{StaticResource Legenda}" Margin="0,4,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Aparência" Tag="M 2,4 Q 2,2 4,2 H 12 Q 14,2 14,4 V 10 Q 14,12 12,12 H 4 Q 2,12 2,10 Z M 5,15 H 11">
                <StackPanel>
                    <TextBlock Text="Aparência" Style="{StaticResource Titulo}"/>
                    <Border Style="{StaticResource Cartao}"><DockPanel>
                        <Border DockPanel.Dock="Left" Width="48" Height="27" CornerRadius="14" Background="Black" BorderBrush="#7E7E8A" BorderThickness="1" Margin="0,0,14,0"/>
                        <StackPanel><TextBlock Text="Preto PUFO" FontWeight="SemiBold"/><TextBlock Text="Tema ativo" Style="{StaticResource Legenda}" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel></Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Módulos" Tag="M 2,2 H 7 V 7 H 2 Z M 10,2 H 15 V 7 H 10 Z M 2,10 H 7 V 15 H 2 Z M 10,10 H 15 V 15 H 10 Z">
                <StackPanel>
                    <TextBlock Text="Módulos" Style="{StaticResource Titulo}"/>
                    <ItemsControl x:Name="Modulos">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Cartao}"><StackPanel>
                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Estado}" Style="{StaticResource Legenda}" Margin="0,4,0,0"/>
                            </StackPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>
            <TabItem x:Name="AbaAssistente" Header="Assistente" Tag="M 5,3 A 3,3 0 0 1 11,3 V 8 A 3,3 0 0 1 5,8 Z M 2,7 A 6,6 0 0 0 14,7 M 8,13 V 16">
                <StackPanel>
                    <TextBlock Text="Assistente" Style="{StaticResource Titulo}"/>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <TextBlock Text="Reconhecimento local · pt-BR" FontWeight="SemiBold"/>
                        <TextBlock x:Name="EstadoMicrofone" Margin="0,5" Style="{StaticResource Legenda}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="Mouse3 na ilha usa o microfone padrão e o Vosk. Clique novamente para cancelar." Style="{StaticResource Legenda}"/>
                        <TextBlock Text="Entrada para teste" Margin="0,9,0,2"/>
                        <ComboBox x:Name="EntradaTeste" DisplayMemberPath="Nome" AutomationProperties.Name="Microfone para teste"/>
                        <ComboBox x:Name="MotorTeste" Margin="0,5,0,0" SelectedIndex="0" AutomationProperties.Name="Motor para teste">
                            <ComboBoxItem Content="Vosk · português"/><ComboBoxItem Content="Windows · pt-BR"/>
                        </ComboBox>
                        <Button Content="Testar reconhecimento" Click="AoTestarEntrada" Style="{StaticResource Acao}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ModeloLocal" TextWrapping="Wrap" Style="{StaticResource Legenda}" Margin="0,5"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <TextBlock Text="Síntese local · pt-BR" FontWeight="SemiBold"/>
                        <ComboBox x:Name="VozTeste" DisplayMemberPath="DisplayName" Margin="0,5" AutomationProperties.Name="Voz para teste"/>
                        <TextBox x:Name="TextoParaFalar" MaxLength="180" Text="Olá. Estou ouvindo." AutomationProperties.Name="Texto para testar a síntese"/>
                        <Button x:Name="TestarFala" Content="Ouvir texto" Click="AoTestarFala" Style="{StaticResource Acao}" Margin="0,6,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Cartao}"><StackPanel>
                        <TextBlock Text="Previsão · Open-Meteo" FontWeight="SemiBold"/>
                        <TextBlock Text="Cidade ou cidade, estado, país" Style="{StaticResource Legenda}" Margin="0,4"/>
                        <TextBox x:Name="CidadeConsulta" MaxLength="140" AutomationProperties.Name="Localidade para o clima"/>
                        <WrapPanel><Button Content="Temperatura" Click="AoConsultarTemperatura" Style="{StaticResource Acao}" Margin="0,6,6,0"/>
                            <Button Content="Chuva hoje" Click="AoConsultarChuva" Style="{StaticResource Acao}" Margin="0,6,0,0"/></WrapPanel>
                    </StackPanel></Border>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="Aviso" Grid.Row="1" Margin="176,8,0,0" Style="{StaticResource Legenda}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
    </DockPanel>
    </Border>
</Window>
