
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>4.0.0-preview.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- O WPF inicia o processo. O NotifyIcon usa WinForms depois que o manifesto definiu o DPI. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' and '$(PufoDistribuicaoInstalada)' == 'true'">
    <AssemblyMetadata Include="PufoDistribuicaoInstalada" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="System.Speech" Version="10.0.15" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

</Project>
