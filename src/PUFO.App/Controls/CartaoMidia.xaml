<UserControl x:Class="PUFO.App.Controls.CartaoMidia"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#F5F5F7">
    <UserControl.Resources>
        <Geometry x:Key="PlayMidia">M 4,1 L 15,8 4,15 Z</Geometry>
        <Geometry x:Key="PauseMidia">M 3,2 H 7 V 14 H 3 Z M 10,2 H 14 V 14 H 10 Z</Geometry>
    </UserControl.Resources>
    <StackPanel>
        <Border x:Name="Divisor" Height="1" Background="#26262C" Margin="0,9,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="Moldura" Width="36" Height="36" CornerRadius="7" Background="#1E1E22" VerticalAlignment="Center">
                <Grid>
                    <Path Data="M 3,11 V 5 L 12,3 V 9 M 2,11 H 4 M 11,10 H 13" Stroke="#AEAEB7" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image x:Name="Capa" Stretch="UniformToFill"><Image.Clip><RectangleGeometry x:Name="RecorteCapa" Rect="0,0,36,36" RadiusX="7" RadiusY="7"/></Image.Clip></Image>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <TextBlock x:Name="Titulo" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Detalhe" Foreground="#A8A8B1" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="Anterior" Style="{DynamicResource IconButton}" Width="26" Height="26" Click="AoAnterior" ToolTip="Anterior" AutomationProperties.Name="Anterior">
                    <Path Data="M 3,2 H 5 V 14 H 3 Z M 14,2 L 5,8 14,14 Z" Fill="#E9E9EE" Stretch="Uniform" Width="12" Height="12"/>
                </Button>
                <Button x:Name="Principal" Style="{DynamicResource IconButton}" Width="28" Height="28" Click="AoPrincipal">
                    <Path x:Name="Glifo" Fill="#F5F5F7" Stretch="Uniform" Width="12" Height="12"/>
                </Button>
                <Button x:Name="Proxima" Style="{DynamicResource IconButton}" Width="26" Height="26" Click="AoProxima" ToolTip="Próxima" AutomationProperties.Name="Próxima">
                    <Path Data="M 3,2 L 12,8 3,14 Z M 12,2 H 14 V 14 H 12 Z" Fill="#E9E9EE" Stretch="Uniform" Width="12" Height="12"/>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="Tempo" Margin="0,4,0,0">
            <Slider x:Name="Progresso" Style="{DynamicResource VolumeSlider}" Height="23" SmallChange="5" LargeChange="15" AutomationProperties.Name="Posição de reprodução"/>
            <DockPanel><TextBlock x:Name="Duracao" DockPanel.Dock="Right" FontSize="10" Foreground="#AAAAB4"/>
                <TextBlock x:Name="Posicao" FontSize="10" Foreground="#AAAAB4"/></DockPanel>
        </StackPanel>
        <StackPanel x:Name="Escolha" Margin="0,4,0,0">
            <Button x:Name="BotaoEscolha" Click="AoAbrirLista" Style="{DynamicResource SaidaButton}" Padding="4" AutomationProperties.Name="Escolher sessão de mídia">
                <DockPanel>
                    <Path DockPanel.Dock="Right" Data="M 1,2 L 6,7 11,2" Stroke="#A8A8B1" StrokeThickness="1.5" VerticalAlignment="Center" Margin="8,0,2,0"/>
                    <TextBlock x:Name="NomeSessao" FontSize="11" Foreground="#BEBEC7" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Button>
            <ScrollViewer x:Name="Lista" Visibility="Collapsed" MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Opcoes">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button x:Name="Selecionar" Style="{DynamicResource SaidaButton}" Click="AoEscolher" ToolTip="{Binding Nome}" AutomationProperties.Name="{Binding Nome}" Padding="6,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                <TextBlock Text="{Binding Detalhe}" Foreground="#A8A8B1" FontSize="10" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Detalhe}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <TextBlock x:Name="Aviso" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="#ACACB7" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
</UserControl>
